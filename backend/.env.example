# Copiar a .env (ignorado por git) y completar con valores reales.

SPRING_PROFILES_ACTIVE=dev

DB_USERNAME=salazar
DB_PASSWORD=salazar

# Mínimo 32 caracteres (HS256 exige una clave de 256 bits); sin esto el backend
# no arranca (WeakKeyException).
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=platos

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

IZIPAY_API_KEY=
IZIPAY_HMAC_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
