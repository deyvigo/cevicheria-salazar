# Copiar a .env (ignorado por git) y completar con valores reales.

SPRING_PROFILES_ACTIVE=dev

DB_USERNAME=salazar
DB_PASSWORD=salazar

# Mínimo 32 caracteres (HS256 exige una clave de 256 bits); sin esto el backend
# no arranca (WeakKeyException).
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# Almacenamiento de imágenes (Garage, compatible con S3). Los tres secretos los genera
# ./scripts/dev.sh la primera vez; en producción van en las variables del VPS.
GARAGE_RPC_SECRET=
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=platos
STORAGE_PUBLIC_BASE_URL=http://platos.web.garage.localhost:3902

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

IZIPAY_API_KEY=
IZIPAY_HMAC_KEY=

# Ej. Gmail: smtp.gmail.com, puerto 587 (STARTTLS) y una contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
